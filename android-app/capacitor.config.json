{
  "appId": "in.saarthh.app",
  "appName": "SAARTH",
  "webDir": "../frontend",
  "server": {
    "url": "https://saarthh.in",
    "cleartext": false,
    "androidScheme": "https"
  },
  "android": {
    "appendUserAgent": "SAARTH_NATIVE_APP",
    "buildOptions": {
      "keystorePath": "saarth.keystore",
      "keystoreAlias": "saarth"
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0a0a0f",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}
