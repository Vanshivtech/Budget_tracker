# ================================================================
# Environment Variables Template
# Copy this file to .env and configure your values.
# Never commit the .env file to Git.
# ================================================================

# --- Groq (LLM) — Multi-key fallback chain ---
# At least one key is required. Get a free key at: https://console.groq.com/keys
# GROQ_API_KEY is an alias for PRIMARY (backward compatible).
GROQ_API_KEY=gsk_your_actual_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: extra keys for automatic failover on rate limits (429) or auth errors
# GROQ_API_KEY_PRIMARY=gsk_primary_key_here
# GROQ_API_KEY_SECONDARY=gsk_secondary_key_here
# GROQ_API_KEY_TERTIARY=gsk_tertiary_key_here

# Optional: fallback to a completely different provider (more resilient than extra Groq keys)
# FALLBACK_PROVIDER=openai
# FALLBACK_API_KEY=sk-your_openai_key_here
# FALLBACK_MODEL=gpt-4o-mini

# --- Database (Supabase Postgres) ---
# In Supabase: Project Settings -> Database -> Connection String -> "URI"
# Use the "Session pooler" (port 5432) or "Transaction pooler" (port 6543)
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres

# --- Authentication ---
# Generate a secure 32-byte secret using:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_generated_random_secret_hex_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=30

# --- Email (Resend HTTP API) ---
# Sign up at https://resend.com and generate an API key starting with re_
# Uses HTTPS (port 443) so Render will not block outbound connections.
RESEND_API_KEY=re_your_api_key_here

# --- Admin Panel Authentication ---
# One admin account, configured entirely via environment variables (never in users table).
# Generate the password hash with:
# python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
ADMIN_EMAIL=admin@budgettracker.local
ADMIN_PASSWORD_HASH=$2b$12$example_bcrypt_hash_goes_here
# Generate a separate 32-byte secret for the admin JWT token:
# python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN_SECRET=your_admin_token_secret_hex_here

# --- Display & Localization ---
CURRENCY_SYMBOL=Rs
TIMEZONE=Asia/Kolkata

# --- Supabase Storage (required only if receipt upload feature is enabled) ---
# SUPABASE_URL is inferred automatically from DATABASE_URL in most cases.
# Set it explicitly here if inference fails (e.g. non-standard Supabase project ref).
# Format: https://yourprojectref.supabase.co
# SUPABASE_URL=https://yourprojectref.supabase.co

# SUPABASE_SERVICE_ROLE_KEY is required for receipt file uploads.
# Without this key the "Upload Receipt" button returns a 503 error silently.
# Find it in: Supabase Dashboard -> Project Settings -> API -> service_role (secret key)
# WARNING: This key bypasses row-level security. Never expose it in the browser.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here

# Storage bucket name for uploaded receipts. Defaults to "receipts".
# Create this bucket in Supabase Dashboard -> Storage before enabling uploads.
# SUPABASE_STORAGE_BUCKET=receipts

# --- Web Push / VAPID Keys ---
# Required for browser push notifications (bill reminders, budget alerts).
# Default embedded test keys are used in local development automatically.
# For production, generate real keys with:
#   npx web-push generate-vapid-keys
# Then replace the values below (uncomment and fill in).
# VAPID_PUBLIC_KEY=BFgUUCw7TdlAzVVLljypdhnjNmR6HOWkLuxNWmOkth2sC2dGSeH6tCwX4RDN_Nr5FPQ3ZGsA9fZ59oRcxySljyA
# VAPID_PRIVATE_KEY=mMNnNYuz5PeeZaCgVP2uvqF_5VuC9omraznptIurZEE
# VAPID_SUBJECT should be a mailto: address reachable by your push service provider.
# VAPID_SUBJECT=mailto:admin@yourdomain.com
