# ================================================================
# Environment Variables Template
# Copy this file to .env and configure your values.
# Never commit the .env file to Git.
# ================================================================

# --- Groq (LLM) ---
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_actual_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Database (Supabase Postgres) ---
# In Supabase: Project Settings -> Database -> Connection String -> "URI"
# Use the "Session pooler" (port 5432) or "Transaction pooler" (port 6543)
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres

# --- Authentication ---
# Generate a secure 32-byte secret using:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_generated_random_secret_hex_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=30

# --- Display & Localization ---
CURRENCY_SYMBOL=₹
TIMEZONE=Asia/Kolkata
